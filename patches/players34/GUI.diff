+// X-1 (players34): the name of player three or four (PlayerIndex 2 or 3), who have no profile: "Player 3", "Player 4"
+// in the game's language (Engine's Localizer), in the URL's form (spaces as underscores, as GetName gives them).
+final function string ExtraPlayerName(int PlayerIndex)
+{
+	return ReplaceSubstr((Class'Engine.Localizer'.default.sPlayerTitle @ string((PlayerIndex + 1))), " ", "_");
+}
+
+// X-1 (players34): GameStartInfoBase.PlayerName has a slot for two players (a native class's layout), so the name of
+// player three or four is a "Name" entry of their own in URLInformation: GetSpawnURL appends it after the one it takes
+// from PlayerName (clamped to player two's), and a URL keeps the last value of an option (FURL::AddOption).
+final function SetExtraPlayerName(int PlayerIndex)
+{
+	local int i;
+	if ((PlayerIndex < 2))
+	{
+		return;
+	}
+	i = 0;
+	while ((i < URLInformation.Length))
+	{
+		if (((URLInformation[i].PlayerIndex == PlayerIndex) && (URLInformation[i].Key ~= "Name")))
+		{
+			break;
+		}
+		(i)++;
+	}
+	if ((i == URLInformation.Length))
+	{
+		URLInformation.Length = (URLInformation.Length + 1);
+	}
+	URLInformation[i].Key = "Name";
+	URLInformation[i].Value = ExtraPlayerName(PlayerIndex);
+	URLInformation[i].PlayerIndex = PlayerIndex;
+}
