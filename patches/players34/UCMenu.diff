+// X-1 (patch set players34): players three and four (child viewports 2 and 3) have no place on a page made for two
+// (the armory): their buttons are used up here, before the page or player two's controls act on them (GetPlayerIndex
+// would name player two's panel; a B nobody takes closes a page). UC2Arena_Character gives them their own.
+function bool InternalOnXControllerEvent( GUIComponent Sender, byte Id, eXControllerCodes Code )
+{
+	local int PlayerIndex;
+
+	PlayerIndex = Controller.FindControllerPortIndex(Id);
+	if ( PlayerIndex >= MAX_VIEWPORTS )
+		return Players34XControl(PlayerIndex, Code);
+
+	return Super.InternalOnXControllerEvent(Sender, Id, Code);
+}
+
+function bool Players34XControl( int PlayerIndex, eXControllerCodes Code )
+{
+	return true;
+}
