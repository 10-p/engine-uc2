+function InternalOnOpen()
+{
+	local int i, PlayerGamepadID;
+	local Player P;
+
+	for ( i = 0; i < Controller.GetViewportCount(true); i++ )
+	{
+		P = Controller.GetViewport(i);
+		PlayerGamepadID = P.GetGamepadID();
+		if ( PlayerGamepadID == ControllerPort )
+			return;
+	}
+
+	
+	
+	Controller.ControllerMask = ControllerMask & ~(1<<ControllerPort);
+	if ( Controller.ControllerMask == 0 )
+		Controller.ControllerMask = 255;
+
+	OnCanClose = None;
+	CloseMenu(true);
+}
