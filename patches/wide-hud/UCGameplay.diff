+// A group drawn at Posn keeps to the side whose third of the 640-wide design space holds its middle; in the middle
+// third it is centred (the shift puts its middle on x=320, to the nearest design pixel).
+final simulated function int SideShift(IconPosn Posn, int LeftShift, int RightShift)
+{
+	local float Mid;
+	Mid = Posn.X + Posn.W * 0.5;
+	if (Mid < 640.0 / 3.0)
+	{
+		return LeftShift;
+	}
+	if (Mid > 1280.0 / 3.0)
+	{
+		return RightShift;
+	}
+	return FFloor(320.5 - Mid);
+}
