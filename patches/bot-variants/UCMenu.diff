+// bot-variants: a slot shows its own character, its X variant or its bot, one at a time; the bot (as the X variant,
+// ToggleAltSkin) is a state of the slot, which both players see
+final function ToggleBot( int CharIdx, bool bDisplayBot )
+{
+	if ( bDisplayBot && AltSkinActive(CharIdx) )
+		ToggleAltSkin(CharIdx, false);
+	else PlayAction(CS_Modify);
+
+	if ( bDisplayBot )
+		BotSlotMask = BotSlotMask | (1 << CharIdx);
+	else BotSlotMask = BotSlotMask & ~(1 << CharIdx);
+}
+
+final function bool BotActive( int CharIdx )
+{
+	return CharIdx >= 0 && bool(BotSlotMask & (1 << CharIdx));
+}
+
+// The player plays the slot's bot when chosen now (players three and four never do: no switch of theirs).
+final function bool ShouldUseBot( int PlayerIndex, int CharIdx )
+{
+	if ( PlayerIndex >= JoyInput.Length || PlayerIndex >= MAX_VIEWPORTS )
+		return false;
+
+	return BotActive(CharIdx) && CanUseBot(CharIdx);
+}
+
+// The slot is the player's and so is its bot.
+final function bool CanUseBot( int CharIdx )
+{
+	return BotAvailable(CharIdx) && bool(ValidCharMask & (1 << CharIdx));
+}
+
+// The slot has a bot and the bot is unlocked.
+final function bool BotAvailable( int CharIdx )
+{
+	return CharIdx >= 0 && bool(BotMask & (1 << CharIdx));
+}
+
+// The slots whose bot is unlocked: the game's own unlock (the bot's bit in a profile's character mask, the bot lists'
+// rule) or the Unlock-all-content flag, as UC2PageBase.ValidCharacterIndex answers for every character.
+final function UpdateBotMask()
+{
+	local int i, Unlock;
+
+	BotMask = 0;
+	for ( i = 0; i < CHARACTER_COUNT; i++ )
+	{
+		Unlock = class'BotVariants'.static.UnlockIndex(class'BotVariants'.static.Find(i));
+		if ( Unlock != -1 && ValidCharacterIndex(Unlock) )
+			BotMask = BotMask | (1 << i);
+	}
+}
+
+// A slot's icon: its bot's while it shows the bot.
+final function Material SlotIcon( int PlayerIndex, int CharIdx, bool bColor, bool bVariant )
+{
+	if ( ShouldUseBot(PlayerIndex, CharIdx) )
+		return class'BotVariants'.static.Icon(class'BotVariants'.static.Find(CharIdx), bColor);
+	return CharInfo.GetCharacterIconAtIndex(CharIdx, bColor, bVariant);
+}
