+// player-name: without a profile, the first player's session is named by the system ini's
+// [Engine.GameReplicationInfo] ServerName (the launcher's server name) instead of the profile default
+// ("Liandri Corporation", which PlayerProfile.SetServerName copies over GameReplicationInfo's default at start-up).
+// Only while the profile-less profile still has that default: a SESSION NAME typed on the host page stays.
+// A loaded profile keeps its own server name. Called where the menus bind the profile's delegates (the first menu of a
+// run) and by the host page (UCMenu Arena_PanelServerMain); not from the SetPlayerName delegate, which Epic's
+// NewProfile also runs while it resets a profile-less profile into a new one (that one starts with the default).
+final function SetProfileServerName(PlayerController PC, PlayerProfile Profile)
+{
+	local string IniServerName;
+	if (((PC == None) || (Profile == None)) || !Profile.IsTransient() || (PC.Player != ViewportOwner))
+	{
+		return;
+	}
+	if ((Profile.GetServerName() != Profile.GetServerName(True)))
+	{
+		return;
+	}
+	if ((GetConfigValue("System", "Engine.GameReplicationInfo", "ServerName", IniServerName) && (IniServerName != "")) && (IniServerName != Profile.GetServerName()))
+	{
+		Log("SetProfileServerName: no profile: the session is named" @ IniServerName @ "([Engine.GameReplicationInfo] ServerName)");
+		Profile.SetServerName(IniServerName);
+	}
+}
