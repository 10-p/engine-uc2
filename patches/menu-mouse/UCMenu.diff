+// a click on one does nothing; the pads press them as before
+final function bool MouseInert( GUIComponent Under )
+{
+	local GUIComponent Part;
+	local int i;
+
+	for ( Part = Under; Part != None; Part = Part.MenuOwner )
+		for ( i = 1; i < MAX_VIEWPORTS; i++ )
+			if ( Part == btn_AltChar[i] )
+				return true;
+	return false;
+}
