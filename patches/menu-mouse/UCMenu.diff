+// menu-mouse: a mouse click on a collapsed panel opens it the way the keys step to it, its selection kept: a panel
+// before the open one as B goes back, the panel after it as A on the open panel's list; the error sound for a panel
+// two steps on; while the mutators are up, a click outside them (MouseInertClick); nothing while the panels move
+final function CollapsedPanelClicked( ArenaListPanel Panel )
+{
+	local int To, From;
+	local ArenaListPanel Open;
+
+	if ( bAnimating || pnl_Game.bAnimating || pnl_Rules.bAnimating || pnl_Maps.bAnimating || pnl_Mutators.bAnimating )
+		return;
+	if ( pnl_Mutators.bVisible )
+	{
+		MouseInertClick();
+		return;
+	}
+
+	To = -1;
+	if ( Panel == pnl_Game )		To = 0;
+	else if ( Panel == pnl_Rules )	To = 1;
+	else if ( Panel == pnl_Maps )	To = 2;
+
+	if ( pnl_Game.IsOpen() )		{ From = 0; Open = pnl_Game; }
+	else if ( pnl_Rules.IsOpen() )	{ From = 1; Open = pnl_Rules; }
+	else if ( pnl_Maps.IsOpen() )	{ From = 2; Open = pnl_Maps; }
+	else return;
+
+	if ( To < 0 || To == From )
+		return;
+	if ( To < From )
+	{
+		if ( Open == pnl_Maps )
+			Controller.LastSelectedMaplistName = GetCurrentMaplistName();
+		Panel.BecomeActive(Open);
+		PlayAction(CS_Cancel);
+	}
+	else if ( To == From + 1 )
+	{
+		if ( Open == pnl_Game )
+			InternalOnClick(li_Games);
+		else
+			InternalOnClick(li_Rules);
+	}
+	else
+		PlayAction(CS_Error);
+	Log("menu-mouse: a click on a collapsed panel" @ Panel.PanelCaption @ "with" @ Open.PanelCaption @ "open", 'DevUI');
+}
+
+// menu-mouse: while the mutators are up, sliding in and out included, every other part of this panel is outside them
+// and inert to the engine's PC mouse, as a collapsed panel is; Under is the component under the pointer
+final function bool MouseInert( GUIComponent Under )
+{
+	local GUIComponent Part;
+
+	if ( !pnl_Mutators.bVisible )
+		return false;
+	for ( Part = Under; Part != None; Part = Part.MenuOwner )
+		if ( Part == pnl_Mutators )
+			return false;
+	return true;
+}
+
+// menu-mouse: a mouse click outside the open mutators is the pad's B on the page, which closes them; nothing while
+// the panels move
+final function MouseInertClick()
+{
+	local eXControllerCodes B;
+
+	if ( bAnimating || pnl_Game.bAnimating || pnl_Rules.bAnimating || pnl_Maps.bAnimating || pnl_Mutators.bAnimating )
+		return;
+	if ( !pnl_Mutators.IsOpen() )
+		return;
+	Log("menu-mouse: a click outside the mutators is B", 'DevUI');
+	B = XC_B;
+	Controller.ClientXControllerEvent(Controller.ControllerId, B);
+}
