+// menu-mouse: a mouse click on the collapsed panel; the page opens it
+delegate OnCollapsedClick( ArenaListPanel Sender );
+
+// menu-mouse: the engine's PC mouse asks the panels under the pointer: a collapsed panel is inert to the mouse (no
+// hover, no focus, no row, no wheel, none of its parts takes a click), and a click on it is the page's OnCollapsedClick
+final function bool MouseInert()
+{
+	return !IsOpen();
+}
+
+final function MouseInertClick()
+{
+	OnCollapsedClick(Self);
+}
 
