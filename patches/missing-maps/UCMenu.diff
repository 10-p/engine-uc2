+// ufront: a custom list entry with no map is the name None in the profile (PlayerProfile.SetMaplist), which the menus
+// would offer as a map. Drops those entries from the list and from the profile's copy of it (in the profile's order); a
+// list left empty gets the game's full list, as a new profile does. True when the list changed.
+final function bool DropUnnamedMaps( Maplist List )
+{
+	local array<string> Saved;
+	local int Current;
+
+	if ( List == None || !RemoveUnnamedMaps(List.Maps) )
+		return false;
+
+	if ( List.Maps.Length == 0 )
+		GetAllMaps(List.Maps);
+	if ( CurrentProfile != None && GameClass != None )
+	{
+		CurrentProfile.GetMaps(GameClass.default.Acronym, Current, Saved);
+		RemoveUnnamedMaps(Saved);
+		if ( Saved.Length == 0 )
+			GetAllMaps(Saved);
+		CurrentProfile.SetMaplist(GameClass.default.Acronym, Current, Saved);
+	}
+	return true;
+}
+
+// ufront: removes the entries that name no map ("" or None); true when there were any.
+static final function bool RemoveUnnamedMaps( out array<string> Maps )
+{
+	local int i;
+	local bool bRemoved;
+
+	for ( i = Maps.Length - 1; i >= 0; i-- )
+		if ( Maps[i] == "" || Maps[i] ~= "None" )
+		{
+			Maps.Remove(i, 1);
+			bRemoved = true;
+		}
+	return bRemoved;
+}
+
 
 
 
