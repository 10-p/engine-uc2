# engine-uc2 holds the port's source only. Game content lives out of tree (the game folder, UE_ASSETS_DIR;
# <repo>/../assets/uc2-assets here) and is never tracked.

# CMake build trees, one per preset. Regenerable; includes FetchContent checkouts under build-*/_deps/.
/build/
/build-*/

*.o
__pycache__/
*.pyc
/node_modules/

# Game content must never enter this repo. These guard against an accidental in-tree drop.
*.u
*.unr
*.utx
*.usx
*.ukx
*.uax
*.umx
*.uix
*.xpr
*.xwb
*.xsb
*.xmv
*.ogg
*.ogv
*.lin
/Assets/
/System/
/Maps/
/Textures/
/StaticMeshes/
/Animations/
/Sounds/
/Music/
/Movies/
/Save/
/Cache/

# UnrealScript is game content: the repo holds patch sets (patches/), never the script sources (Epic's are in
# ../epic-sources/uc2-avaris-2226/<Pkg>/Classes); the build decompiles the shipped .u into build-*/Scripts.
/Source/*/Classes/
/Source/*/*.ucproject

# No blanket *.a / *.lib / *.dll rule: a vendored prebuilt would be silently masked.

# Per-machine local overrides.
.claude/settings.local.json

# The Android Gradle project's build state (Android/): Gradle's caches, the build trees, the NDK's CMake trees
# (FetchContent checkouts under them), the SDL checkout the build fetches, this machine's SDK paths, Android
# Studio's project files.
/Android/.gradle/
/Android/.kotlin/
/Android/build/
/Android/app/build/
/Android/app/.cxx/
/Android/local.properties
/Android/.idea/
*.iml
