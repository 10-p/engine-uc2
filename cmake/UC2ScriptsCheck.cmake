# UC2ScriptsCheck.cmake -- the input checks of the script build.
# Included by cmake/UC2Scripts.cmake at configure time, and run with `cmake -P` by the build (so a file replaced
# after the configure is caught too):
#
#   cmake -DUE_CHECK=shipped -DDIR=<System> -DSUMS=<patches/shipped.sha256> -DPACKAGES=A;B;... -P UC2ScriptsCheck.cmake
#       every <DIR>/<Pkg>.u of PACKAGES must be the shipped file (sha256 listed in SUMS)
#   cmake -DUE_CHECK=copy -DSRC=<dir> -DDST=<dir> [-DSTAMP=<file>] [-DREQUIRE=1] -P UC2ScriptsCheck.cmake
#       mirror SRC/*.u into DST (each must be an Unreal package; files of DST not in SRC are removed; a missing SRC
#       empties DST unless REQUIRE); STAMP is touched only when something in DST changed
cmake_minimum_required(VERSION 3.21)

# uc2_scripts_check_shipped(<dir> <sums-file> <packages> <result-var>): empty result when every package is the
# shipped file, else the message that says which one is not and what to do.
function(uc2_scripts_check_shipped dir sums packages out)
  file(STRINGS "${sums}" _lines REGEX "^[0-9a-f]+  [A-Za-z]+\\.u$")
  set(_msg "")
  foreach(_p IN LISTS packages)
    set(_want "")
    foreach(_l IN LISTS _lines)
      if(_l MATCHES "^([0-9a-f]+)  ${_p}\\.u$")
        set(_want "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(NOT _want)
      string(APPEND _msg "  ${_p}.u: not listed in ${sums}\n")
      continue()
    endif()
    if(NOT EXISTS "${dir}/${_p}.u")
      string(APPEND _msg "  ${dir}/${_p}.u: missing\n")
      continue()
    endif()
    file(SHA256 "${dir}/${_p}.u" _have)
    if(NOT _have STREQUAL _want)
      string(APPEND _msg "  ${dir}/${_p}.u: sha256 ${_have}, not the shipped file (${_want})\n")
    endif()
  endforeach()
  if(_msg)
    set(_bad "${_msg}")
    set(_msg "The script build starts from the game's SHIPPED script packages (the retail disc's System folder, ")
    string(APPEND _msg "the same files as Epic's System folder), and these are not:\n${_bad}\n")
    string(APPEND _msg "A package rebuilt from source (for example one an earlier patched build installed into the game ")
    string(APPEND _msg "folder, see System/SCRIPTS.txt there) cannot be the base: decompiling it would apply the patches ")
    string(APPEND _msg "twice.\n\nPut the shipped files back (from the disc), or point -DUE_SCRIPT_PACKAGES_DIR=<dir> at a ")
    string(APPEND _msg "folder holding the 17 shipped .u files, or build without the script patches: ")
    string(APPEND _msg "-DUE_SCRIPT_PATCHES=OFF.\n\nThe shipped checksums are patches/shipped.sha256 (`sha256sum -c` in ")
    string(APPEND _msg "the System folder checks them).")
  endif()
  set(${out} "${_msg}" PARENT_SCOPE)
endfunction()

# uc2_scripts_mirror(<src> <dst> <require> <changed-var> <error-var>)
function(uc2_scripts_mirror src dst require changed err)
  set(_changed 0)
  set(_err "")
  set(_files "")
  if(EXISTS "${src}")
    file(GLOB _files LIST_DIRECTORIES false "${src}/*.u")
  endif()
  if(require AND NOT _files)
    set(_err "no script packages (*.u) in ${src}")
  endif()
  foreach(_f IN LISTS _files)
    file(READ "${_f}" _magic LIMIT 4 HEX)
    if(NOT _magic STREQUAL "c1832a9e")
      string(APPEND _err "${_f}: not an Unreal package\n")
    endif()
  endforeach()
  if(_err)
    set(${err} "${_err}" PARENT_SCOPE)
    set(${changed} 0 PARENT_SCOPE)
    return()
  endif()
  file(MAKE_DIRECTORY "${dst}")
  set(_names "")
  foreach(_f IN LISTS _files)
    get_filename_component(_n "${_f}" NAME)
    list(APPEND _names "${_n}")
    set(_same 0)
    if(EXISTS "${dst}/${_n}")
      file(SHA256 "${_f}" _a)
      file(SHA256 "${dst}/${_n}" _b)
      if(_a STREQUAL _b)
        set(_same 1)
      endif()
    endif()
    if(NOT _same)
      file(COPY_FILE "${_f}" "${dst}/${_n}")
      set(_changed 1)
    endif()
    # served and installed like any game file (ucc saves 0600)
    file(CHMOD "${dst}/${_n}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  endforeach()
  file(GLOB _old LIST_DIRECTORIES false "${dst}/*")
  foreach(_f IN LISTS _old)
    get_filename_component(_n "${_f}" NAME)
    if(NOT _n IN_LIST _names)
      file(REMOVE "${_f}")
      set(_changed 1)
    endif()
  endforeach()
  set(${changed} ${_changed} PARENT_SCOPE)
  set(${err} "" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND UE_CHECK STREQUAL "shipped")
  uc2_scripts_check_shipped("${DIR}" "${SUMS}" "${PACKAGES}" _m)
  if(_m)
    message(FATAL_ERROR "${_m}")
  endif()
elseif(CMAKE_SCRIPT_MODE_FILE AND UE_CHECK STREQUAL "copy")
  if(REQUIRE)
    set(_req 1)
  else()
    set(_req 0)
  endif()
  uc2_scripts_mirror("${SRC}" "${DST}" ${_req} _ch _e)
  if(_e)
    message(FATAL_ERROR "scripts: ${_e}\nRun the host preset first (cmake --build build-native), pass "
                        "-DUE_SCRIPTS_DIR=<its Scripts/System>, or configure with -DUE_SCRIPT_PATCHES=OFF.")
  endif()
  file(GLOB _now LIST_DIRECTORIES false "${DST}/*.u")
  list(LENGTH _now _n)
  if(_ch)
    message(STATUS "scripts: ${_n} script packages in ${DST} (updated from ${SRC})")
  else()
    message(STATUS "scripts: ${_n} script packages in ${DST} (unchanged)")
  endif()
  if(STAMP AND (_ch OR NOT EXISTS "${STAMP}"))
    file(TOUCH "${STAMP}")
  endif()
endif()
