# The owner's spot (WHEREAMI -337.1 2.3 -418.4 32950 1193), third person; frames over time, then the view turned
# (TELEPORT keeps the place, changes yaw/pitch), then the pawn moved away and back.
chan exec TELEPORT -337.1 2.3 -418.4 32950 1193
sleep 3
chan exec TELEPORT -337.1 2.3 -418.4 32950 1193
sleep 2
chan exec WHEREAMI
shot t0
sleep 1
shot t1
sleep 2
shot t3
