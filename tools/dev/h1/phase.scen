# H-1 part 2: the view moved by about one reference pixel (3 screen px at 1440 lines) at a time over the 4 x 4
# positions of the scale-1 bloom select grid (yaw +19, pitch +22 per step); at each: scale 1, scale 2 (both freshly made
# targets), effect off. tools/dev/h1-phase.sh measures it.
chan exec ToggleThirdCam
sleep 1
chan exec set UC2GLRenderDevice PostProcessTargetScale 2
sleep 1
chan exec set LevelInfo TimeDilation 1
chan exec NETPLACE FxCam 1229.6 -672.9 -108 40448 0
sleep 2.5
chan exec NETPLACE FxCam 1229.6 -672.9 -108 40448 0
sleep 3
chan exec set LevelInfo TimeDilation 0.0001
chan exec set UCScreenDOF Enabled 0
chan exec set UC2GLRenderDevice PostProcessTargetScale 1
sleep 2.5
shot q0s1
chan exec set UC2GLRenderDevice PostProcessTargetScale 2
sleep 2.5
shot q0s2
chan exec set UC2GLRenderDevice PostProcessTargetScale 1
chan exec set UCScreenEmissiveWithBloom Enabled 0
sleep 1.5
shot q0off
chan exec set UCScreenEmissiveWithBloom Enabled 1
chan exec set LevelInfo TimeDilation 1
chan exec NETPLACE FxCam 1229.6 -672.9 -108 40467 0
sleep 2.5
chan exec NETPLACE FxCam 1229.6 -672.9 -108 40467 0
sleep 3
chan exec set LevelInfo TimeDilation 0.0001
chan exec set UCScreenDOF Enabled 0
chan exec set UC2GLRenderDevice PostProcessTargetScale 1
sleep 2.5
