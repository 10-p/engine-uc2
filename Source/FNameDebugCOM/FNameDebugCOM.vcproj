						PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_UNICODE;_AFXDLL;$(NoInherit)"
						BasicRuntimeChecks="3"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath="FNameDebugCOM.cpp">
				<FileConfiguration
					Name="Unicode Debug|Win32">
