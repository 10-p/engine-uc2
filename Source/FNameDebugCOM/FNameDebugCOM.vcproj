						InterfaceIdentifierFileName="FNameDebugCOM_i.c"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath="FNameDebugCOM.rc">
				<FileConfiguration
					Name="Unicode Debug|Win32">
