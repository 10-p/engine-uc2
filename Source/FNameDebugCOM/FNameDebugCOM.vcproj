						Name="VCCLCompilerTool"
						Optimization="0"
						PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_UNICODE;_AFXDLL;$(NoInherit)"
						BasicRuntimeChecks="3"/>
