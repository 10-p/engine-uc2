/* scion ======================================================================
 * Author: sz
 * ============================================================================
 * PS_SkinShaderSpecLightOpacity
 *
 * Same as SkinShaderSpecLight.psh but with an opacity channel.
 * Also the alpha color modifier value is biased by -127 
 * (similar to HandleOpacityBitmap).
 *
 * Final Color = (c0.rgb * ((t0 + (t0.a * t1) + t3) * v0 * 2))
 * Final Alpha = (t2.a + (c0.a - 0.5) )
 *
 * ============================================================================
 */
 
xps.1.1

// Diffuse
tex t0
// Specular
tex t1
// Opacity
tex t2
// Rim Light
tex t3

// Mask the specular and add the rim light
// r1 = (t0.a * t1) + t3
mad r1, t1, t0.a, t3

// Add the specular to the diffuse
// r0 = ((t0 + (t0.a * t1) + t3)
add r0, t0, r1

// Modulate the diffuse + specular + rim with the lighting
// r0 = ((t0 + (t0.a * t1) + t3) * v0) * 2
mul_x2 r0, r0, v0

// Now modulate with the constant color
// r0.rgb = (c0.rgb * ((t0 + (t0.a * t1) + t3) * v0 * 2))
// r0.a = (t2.a + (c0.a - 0.5) )
mul r0.rgb, r0, c0
+ add r0.a, t2.a, c0_bias.a

xfc fog.a, r0, fog.rgb, zero, zero, zero, r0.a
