/* scion ======================================================================
 * Author: jg
 * ============================================================================
 *
 * This pixel shader combines the back buffer with various materials to create
 * a video feed effect. It adds the two noise textures together and then alpha
 * blends that result with the back buffer texture using the noise mask.
 *
 * ============================================================================
 */

xps.1.1

// Load the back buffer texture
tex t0
// Load the noise mask
tex t1
// Load the noise texture
tex t2
// Load the second noise texture
tex t3

// Add the two noise textures together
add r1, t2, t3
// Blend between the noise texture and the back buffer using the mask
lrp r0, t1.a, r1, t0

xfc fog.a, r0, fog.rgb, zero, zero, zero, 1 - zero
