/* scion ======================================================================
 * Author: sz
 * ============================================================================
 * PS_SkinShaderOpacity
 *
 * Same as SkinShader.psh but with an opacity channel.
 * Also the alpha color modifier value is biased by -127 
 * (similar to HandleOpacityBitmap).
 *
 * Final Color = ((c0.rgb * (t0 * v0) * 2) + (t0.a * t1) + (t3))
 * Final Alpha = (t2.a + (c0.a - 0.5) )
 *
 * ============================================================================
 */

xps.1.1

// Diffuse
tex t0
// Specular
tex t1
// Opacity
tex t2
// Rim Light
tex t3

// Mask the specular
// r1 = (t0.a * t1) + t3
mad r1, t1, t0.a, t3

// Modulate the diffuse with lighting
// r0 = (t0 * v0) * 2
mul_x2 r0, t0, v0

// Now modulate with the constant color and add specular
// r0.rgb = (c0.rgb * (t0 * v0 * 2)) + (t0.a * t1) + (t3)
// r0.a = (t2.a + (c0.a - 0.5) )
mad r0.rgb, r0, c0, r1
+ add r0.a, t2.a, c0_bias.a

xfc fog.a, r0, fog.rgb, zero, zero, zero, r0.a
