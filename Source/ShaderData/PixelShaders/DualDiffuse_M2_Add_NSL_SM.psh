/* scion ======================================================================
 * Author: jg
 * ============================================================================
 *
 * This material is an optimized version of a combiner in the diffuse channel of
 * a UShader. This shader is 2 diffuse, mask in stage 2, additive blending,
 * specular mask in stage 4 and no lighting on the specular.
 * The formula is (((T0.rgb + T1.rgb) * T1.a) * V0) + (T2 * T3.a)
 *
 * ============================================================================
 */

xps.1.1

// Diffuse
tex t0
// Diffuse2
tex t1
// Specular
tex t2
// Specular mask
tex t3

// Add the two diffuse textures together and mask with t1.a
xmma discard, discard, r0, t0.rgb, t0.a, t1.rgb, t1.a
// Now modulate the diffuse with the lighting
mul_x2 r0, r0, v0
// Finally add in the masked specular
mad r0, t2, t3.a, r0
