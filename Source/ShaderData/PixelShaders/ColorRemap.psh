/* scion ======================================================================
 * Author: jg
 * ============================================================================
 *
 * This material performs color remapping in a single pass. c0 contains the
 * amount to blend between the remapped color and the original backbuffer
 *
 * ============================================================================
 */

xps.1.1

// Diffuse (backbuffer)
tex t0
// Calculate luminance
texm3x2pad t1, t0
texm3x2tex t2, t0

// Now lerp between the original backbuffer value and the remapped color
lrp r0, c0.a, t2, t0
