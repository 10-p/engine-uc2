/* scion ======================================================================
 * Author: sz
 * ============================================================================
 * Additive projector pixel shader (PS_Projector_AlphaBlend_2).
 * The alpha from the opacity bitmap is used to mask out areas where the projector
 * should not be applied.  The diffuse/specular colors are used to attenuate each 
 * projected texture.  The values are set based off of the dot product from the
 * vertex normal to the projector direction.  This is done in a vertex shader.
 *
 * AlphaBlend Mode:
 *		r0.rgb	= (t1.rgb * t1.a * v0.a) + (t2.rgb * t2.a * v1.a)
 *		r0.a	= (t1.a * v0.a + t2.a * v1.a)*t0.a
 *
 * Assumes:
 *		SrcBlend = D3DBLEND_SRCALPHA
 *		DestBlend = D3DBLEND_INVSRCALPHA
 *
  * Only Alpha/Blue channels can be replicated to all other channels, so:
 *			v0.a = t1 attenuation
 *			v1.a = t2 attenuation
 *
 * ============================================================================
 */

xps.1.1

tex t0		// opacity bitmap from base material
tex t1		// projected texture 1
tex t2		// projected texture 2

// r0.rgb	= (t1.rgb * t1.a)
// r1.rgb	= (t2.rgb * t2.a)
xmma r0.rgb, r1.rgb, discard.rgb, t1.rgb, t1.a, t2.rgb, t2.a

// r0.rgb	= (r0.rgb * v0.a) + (r1.rgb * v1.a)
// r0.a		= (t1.a * v0.a) + (t2.a * v1.a)
xmma discard.rgb, discard.rgb, r0.rgb, r0.rgb, v0.a, r1.rgb, v1.a
+ xmma discard.a, discard.a, r0.a, t1.a, v0.a, t2.a, v1.a

// r0.a = r0.a * t0.a
mul r0.a, r0.a, t0.a

xfc zero, zero, r0.rgb, zero, zero, zero, r0.a
