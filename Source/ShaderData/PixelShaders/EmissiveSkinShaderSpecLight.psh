/* scion ======================================================================
 * Author: jg
 * ============================================================================
 *
 * This material is an optimized version of the original Unreal Shader class
 * used for character skins. It takes materials that would have been 2 passes
 * using the fixed function pipeline and makes them single pass materials. This
 * code assumes that the Alpha channel of the diffuse is the mask to use for
 * the specular. It also applies the mesh lighting to the diffuse and specular. 
 * The emissive mask is used to either wholly use the modulated diffuse or the
 * diffuse without any lighting modulation. Note that the alpha value written
 * to the back buffer is the amount of light bloom to apply. c0 contains a
 * constant that I use to wildly scale the alpha. This lets me do things as if
 * I had a conditional without having one by having a value be 0 or 1
 *
 * ============================================================================
 */

xps.1.1

// Diffuse
tex t0
// Specular
tex t1
// RimLight
tex t2
// Emissive mask
tex t3

// Modulate the diffuse with the lighting
mul_x2 r0, t0, v0
// Determine whether or not there is a mask being used for an emissive material
// This is an all or nothing operation in terms of choosing the color portion
// of what gets written to the back buffer. The alpha is always the unmodified
// value from t3.a
xmma_x4 discard, discard, r1, t3.a, c0, t3.a, c0
// Modulate the diffuse (emissive) with the specified color
mul r1.rgb, c1.rgb, t0
+mul r1.a, c1.a, r1_sat.a
// Now blend the original diffuse/specular mess all or nothing with the
// emissive diffuse
xmma discard, discard, r0, r0, 1 - r1.a, r1, r1.a
// Mask the specular and add in the rim light
mad r1, t1, t0.a, t2
// Modulate the specular with lighting and add to the diffuse/emissive
mul_x2 r1, v0, r1
add r0, r1, r0

// Use the XFC to specify how much light bloom to apply
xfc fog.a, r0, fog.rgb, zero, zero, zero, t3.a
