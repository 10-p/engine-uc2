/* scion ======================================================================
 * Author: jg
 * ============================================================================
 *
 * This material is an optimized version of a combiner in the diffuse channel of
 * a UShader. This shader is 2 diffuse, mask in stage 1, additive blending, and
 * no lighting on the specular.
 * The formula is (((T0.rgb + T1.rgb) * T0.a) * V0) + T2
 *
 * ============================================================================
 */

xps.1.1

// Diffuse
tex t0
// Diffuse2
tex t1
// Specular
tex t2

// Add the two diffuse textures together and mask with t0.a
xmma discard, discard, r0, t0.rgb, t0.a, t1.rgb, t0.a
// Now modulate the diffuse with the lighting
mul_x2 r0, r0, v0
// Finally add in the specular
add r0, r0, t2
