/* scion ======================================================================
 * Author: jg
 * ============================================================================
 *
 * This material is the optimized version of a shader that uses a mask from the
 * diffuse texture for opacity and a separate mask for specularity. Instead of
 * being 2 passes it is only a single pass. This one modulates the specular
 * with lighting too.
 *
 * ============================================================================
 */

xps.1.1

// Diffuse
tex t0
// Specular
tex t1
// Specular mask
tex t2

// Mask the specular and add the diffuse
mad r0, t1, t2.a, t0
// Modulate the result with lighting
mul_x2 r0, r0, v0

// Now mask the whole thing with the diffuse alpha
xfc fog.a, r0, fog.rgb, zero, zero, zero, t0.a
