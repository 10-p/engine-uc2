xps.1.1

//-----------------------------------------------------------------------------
// texture stages

tex t0					// blend material

//-----------------------------------------------------------------------------
//  

// Modulate the blend material with the specified constant color
mul r0.rgb, t0, c0
// Modulate by the diffuse alpha
mul r0.rgb, r0.rgb, t0.a
mul r0.rgb, r0.rgb, v0.a

// alpha = 1
xfc zero, zero, r0.rgb, zero, zero, zero, 1-zero
