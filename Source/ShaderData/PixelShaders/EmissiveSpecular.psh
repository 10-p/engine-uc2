/* scion ======================================================================
 * Author: jg
 * ============================================================================
 *
 * This material emits light from the specular texture. The emissive mask is
 * used to mask the specular and determines whether the diffuse texture is used
 * or the specular material. The diffuse is fully modulated with lighting and
 * the specular if completely unlit. The alpha controls how emissive the
 * material is. c1 contains the emissive color modifier
 *
 * ============================================================================
 */

xps.1.1

// Diffuse
tex t0
// Specular
tex t1
// Emissive mask
tex t2

// Modulate the diffuse with the lighting
mul_x2 r0, t0, v0
// Determine whether or not there is a mask being used for an emissive material
// This is an all or nothing operation in terms of choosing the color portion
// of what gets written to the back buffer. The alpha comes from t2.a and is
// modulated (post pixel selection) by the color in c1
xmma_x4 discard, discard, r1, t2.a, c0, t2.a, c0
// This is annoying but waste an instruction purely to saturate the result
mov r1, r1_sat
// Modulate the emissive material with the emissive color
mul r1.rgb, t1, c1
// Now blend the original diffusemess all or nothing with the emissive diffuse
xmma discard, discard, r0, r0, 1 - r1.a, r1, r1.a
// Now modulate the amount light bloom to apply
mul r1.a, t2.a, c1.a

// Use the XFC to specify how much light bloom to apply
xfc fog.a, r0, fog.rgb, zero, zero, zero, r1.a
