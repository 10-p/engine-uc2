<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="Setup"
	SccProjectName="Perforce Project"
	SccAuxPath=""
	SccLocalPath=".."
	SccProvider="MSSCCI:Perforce SCM">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory=".\..\Lib"
			IntermediateDirectory=".\Release"
			ConfigurationType="1"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="3"
				GlobalOptimizations="TRUE"
				InlineFunctionExpansion="2"
				EnableIntrinsicFunctions="TRUE"
				FavorSizeOrSpeed="1"
				OmitFramePointers="FALSE"
				OptimizeForProcessor="2"
				AdditionalIncludeDirectories="..\..\Core\Inc,..\..\Window\Inc,..\Inc,."
				PreprocessorDefinitions="_WINDOWS,NDEBUG,UNICODE,_WIN32_IE=0x0200,WIN32"
				StringPooling="TRUE"
				MinimalRebuild="FALSE"
				RuntimeLibrary="2"
				StructMemberAlignment="3"
				BufferSecurityCheck="FALSE"
				EnableFunctionLevelLinking="TRUE"
				ForceConformanceInForLoopScope="TRUE"
				PrecompiledHeaderFile=".\Release/Setup.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"
				BrowseInformation="0"
				WarningLevel="4"
				WarnAsError="TRUE"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="1"
				CompileAs="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="..\..\Window\Lib\Window.lib ..\..\Core\Lib\Core.lib ..\..\zlib\release\zlib.lib wsock32.lib"
				OutputFile="..\..\System\Setup.exe"
				LinkIncremental="2"
				SuppressStartupBanner="TRUE"
				IgnoreDefaultLibraryNames="LIBCD;LIBCMTD;MSVCRTD;LIBC;LIBCMT"
				ProgramDatabaseFile=".\..\Lib/Setup.pdb"
				SubSystem="2"
				OptimizeReferences="0"
				BaseAddress="0x10400000"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\..\Lib/Setup.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory=".\..\Lib"
			IntermediateDirectory=".\Debug"
			ConfigurationType="1"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="..\..\Core\Inc,..\..\Window\Inc,..\Inc,."
				PreprocessorDefinitions="_WINDOWS,UNICODE,_DEBUG,_WIN32_IE=0x0200,WIN32"
				MinimalRebuild="TRUE"
				BasicRuntimeChecks="2"
				RuntimeLibrary="2"
				StructMemberAlignment="3"
				ForceConformanceInForLoopScope="TRUE"
				PrecompiledHeaderFile=".\Debug/Setup.pch"
				AssemblerListingLocation=".\Debug/"
				ObjectFile=".\Debug/"
				ProgramDataBaseFileName=".\Debug/"
				WarningLevel="4"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="4"
				CompileAs="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/MACHINE:I386"
				AdditionalDependencies="..\..\Window\Lib\Window.lib ..\..\Core\Lib\Core.lib ..\..\zlib\debug\zlib.lib wsock32.lib"
				OutputFile="..\..\System\Setup.exe"
				LinkIncremental="2"
				SuppressStartupBanner="TRUE"
				IgnoreDefaultLibraryNames="LIBCD;LIBCMTD;MSVCRTD;LIBC;LIBCMT"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\..\Lib/Setup.pdb"
				SubSystem="2"
				BaseAddress="0x10400000"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\..\Lib/Setup.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Profiling|Win32"
			OutputDirectory="Profiling"
			IntermediateDirectory="Profiling"
			ConfigurationType="1"
			UseOfMFC="0"
			ATLMinimizesCRunTimeLibraryUsage="FALSE"
			CharacterSet="1"
			WholeProgramOptimization="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="3"
				GlobalOptimizations="TRUE"
				InlineFunctionExpansion="2"
				EnableIntrinsicFunctions="TRUE"
				FavorSizeOrSpeed="1"
				OptimizeForProcessor="2"
				AdditionalIncludeDirectories="..\..\Core\Inc,..\..\Window\Inc,..\Inc,."
				PreprocessorDefinitions="_WINDOWS,NDEBUG,UNICODE,_WIN32_IE=0x0200,WIN32"
				StringPooling="TRUE"
				RuntimeLibrary="2"
				StructMemberAlignment="3"
				EnableFunctionLevelLinking="TRUE"
				ForceConformanceInForLoopScope="TRUE"
				PrecompiledHeaderFile=".\Release/Setup.pch"
				AssemblerListingLocation=".\Release/"
				ObjectFile=".\Release/"
				ProgramDataBaseFileName=".\Release/"
				WarningLevel="4"
				WarnAsError="TRUE"
				SuppressStartupBanner="TRUE"
				DebugInformationFormat="3"
				CompileAs="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/FIXED:NO"
				AdditionalDependencies="..\..\Window\Lib\Window.lib ..\..\Core\Lib\Core.lib"
				OutputFile="..\..\System\Setup.exe"
				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				IgnoreDefaultLibraryNames="LIBCD;LIBCMTD;MSVCRTD;LIBC;LIBCMT"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile=".\..\Lib/Setup.pdb"
				GenerateMapFile="TRUE"
				MapExports="TRUE"
				MapLines="TRUE"
				SubSystem="2"
				BaseAddress="0x10400000"/>
			<Tool
				Name="VCMIDLTool"
				PreprocessorDefinitions="NDEBUG"
				MkTypLibCompatible="TRUE"
				SuppressStartupBanner="TRUE"
				TargetEnvironment="1"
				TypeLibraryName=".\..\Lib/Setup.tlb"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"
				PreprocessorDefinitions="NDEBUG"
				Culture="1033"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Src"
			Filter="*.cpp">
			<File
				RelativePath=".\Setup.cpp">
			</File>
			<File
				RelativePath=".\SetupPrivate.h">
			</File>
			<File
				RelativePath=".\USetupDefinition.cpp">
			</File>
			<File
				RelativePath=".\USetupDefinitionWindows.cpp">
			</File>
		</Filter>
		<Filter
			Name="Inc"
			Filter="*.h">
			<File
				RelativePath=".\Res\resource.h">
			</File>
			<File
				RelativePath="..\Inc\Setup.h">
			</File>
			<File
				RelativePath="..\Inc\USetupDefinitionWindows.h">
			</File>
		</Filter>
		<Filter
			Name="Res"
			Filter="">
			<File
				RelativePath=".\Res\idicon_s.ico">
			</File>
			<File
				RelativePath=".\Res\idicon_t.ico">
			</File>
			<File
				RelativePath=".\Res\SetupRes.rc">
				<FileConfiguration
					Name="Release|Win32">
					<Tool
						Name="VCResourceCompilerTool"
						AdditionalIncludeDirectories="Res;$(NoInherit)"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Debug|Win32">
					<Tool
						Name="VCResourceCompilerTool"
						AdditionalIncludeDirectories="Res;$(NoInherit)"/>
				</FileConfiguration>
				<FileConfiguration
					Name="Profiling|Win32">
					<Tool
						Name="VCResourceCompilerTool"
						AdditionalIncludeDirectories="Res;$(NoInherit)"/>
				</FileConfiguration>
			</File>
			<File
				RelativePath=".\Res\Unreal.ico">
			</File>
		</Filter>
		<Filter
			Name="Classes"
			Filter="*.uc">
			<File
				RelativePath="..\Classes\SetupDefinition.uc">
			</File>
			<File
				RelativePath="..\Classes\SetupGroup.uc">
			</File>
			<File
				RelativePath="..\Classes\SetupLink.uc">
			</File>
			<File
				RelativePath="..\Classes\SetupObject.uc">
			</File>
			<File
				RelativePath="..\Classes\SetupProduct.uc">
			</File>
		</Filter>
		<Filter
			Name="Int"
			Filter="*.int">
			<File
				RelativePath="..\..\System\Setup.int">
			</File>
		</Filter>
	</Files>
	<Globals>
	</Globals>
</VisualStudioProject>
